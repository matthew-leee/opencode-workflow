{
  // OpenCode v2 (2.3.2) global configuration — canonical copy.
  // Synced to ~/.config/opencode/opencode.jsonc by `npm run sync`. Validate with `npm run verify`.
  "$schema": "https://opencode.ai/config.json",

  // Primary driver: Gemini 4 Neon at high reasoning effort (variant resolved from the model catalog).
  "model": "openrouter/google/gemini-4-neon#high",
  "default_agent": "build",

  "compaction": {
    "auto": true,
    "background": true,
    "buffer": "20%",
    "keep": { "tokens": 15000 }
  },
  "tool_output": { "max_lines": 2000, "max_bytes": 51200 },
  "media": {
    "image": {
      "auto_resize": true,
      "max_width": 2000,
      "max_height": 2000,
      "max_base64_bytes": 5242880
    }
  },

  // Ordered rules — later rules win. Everyday inspection/test/build stays silent.
  // Concise static baseline here; structured shell command parsing (real `.env` secrets,
  // destructive local ops, remote/infra/DB mutations, while staying silent on `.env.example`
  // and `process.env` in code) runs in `plugins/audit-logger/permission-guard.js` via
  // `permission.hook("evaluate")`.
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },

    // Secret files on single-path file tools (unambiguous path globs).
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "edit", "resource": "*.env", "effect": "ask" },
    { "action": "edit", "resource": "*.env.*", "effect": "ask" },
    { "action": "write", "resource": "*.env", "effect": "ask" },
    { "action": "write", "resource": "*.env.*", "effect": "ask" },
    { "action": "patch", "resource": "*.env", "effect": "ask" },
    { "action": "patch", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "*id_rsa*", "effect": "ask" },
    { "action": "read", "resource": "*id_ed25519*", "effect": "ask" },
    { "action": "read", "resource": "*.pem", "effect": "ask" },
    { "action": "read", "resource": "*/secrets/*", "effect": "ask" },

    // Template escape hatch for single-path file tools only (declared after the ask rules).
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "write", "resource": "*.env.example", "effect": "allow" },
    { "action": "patch", "resource": "*.env.example", "effect": "allow" },

    // Fail-closed static fallbacks if plugins are ever disabled (high-impact destructive/remote
    // ops plus shell `.env*`). At runtime, `permission-guard.js` parses shell commands cleanly:
    // asks on real `.env`/`.env.local` and all destructive/remote/infra/DB mutations, while
    // overriding the static `*.env*` fallback to `allow` ONLY when every `.env` token is a safe
    // template (`.env.example`) or code identifier (`process.env`).
    { "action": "shell", "resource": "rm -rf*", "effect": "ask" },
    { "action": "bash", "resource": "rm -rf*", "effect": "ask" },
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "bash", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "git reset*", "effect": "ask" },
    { "action": "bash", "resource": "git reset*", "effect": "ask" },
    { "action": "shell", "resource": "sudo*", "effect": "ask" },
    { "action": "bash", "resource": "sudo*", "effect": "ask" },
    { "action": "shell", "resource": "*.env*", "effect": "ask" },
    { "action": "bash", "resource": "*.env*", "effect": "ask" },
  ],

  "agents": {
    // Primary driver — decides and executes, routes work to the agents below.
    "build": {
      "mode": "primary",
      "model": "openrouter/google/gemini-4-neon#high",
      "description": "Primary driver. Plans, executes, and auto-routes work to worker/reviewer/fact-checker/escalation agents."
    },

    // Plan mode: read + shell allowed, edits restricted to plan artefacts.
    "plan": {
      "mode": "primary",
      "model": "openrouter/google/gemini-4-neon#high",
      "description": "Read-only planner. Investigates and writes plans; cannot touch implementation files.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "write", "resource": "*", "effect": "deny" },
        { "action": "patch", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "/root/.opencode/plan/*", "effect": "allow" },
        { "action": "write", "resource": "/root/.opencode/plan/*", "effect": "allow" },
        { "action": "edit", "resource": "/root/pi-projects/**/PLAN.md", "effect": "allow" },
        { "action": "write", "resource": "/root/pi-projects/**/PLAN.md", "effect": "allow" },
        { "action": "edit", "resource": "/root/financeBot/PLAN.md", "effect": "allow" },
        { "action": "write", "resource": "/root/financeBot/PLAN.md", "effect": "allow" }
      ]
    },

    // Bounded implementation: cheap, fast, allowed to edit and run tests.
    "worker": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017",
      "description": "Bounded implementer for clearly specified, routine edits/tests/docs. Reports what changed and what it verified; never commits.",
      "steps": 60,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" }
      ]
    },

    // Independent cross-vendor review: no writes, inspection only.
    "reviewer": {
      "mode": "subagent",
      "model": "openrouter/anthropic/claude-sonnet-5.5",
      "description": "Independent cross-vendor code reviewer. Audits diffs against requirements and rules; never edits, never commits.",
      "steps": 40,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "write", "resource": "*", "effect": "deny" },
        { "action": "patch", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" }
      ]
    },

    // Independent factual/citation verification.
    "fact-checker": {
      "mode": "subagent",
      "model": "openrouter/anthropic/claude-sonnet-5.5",
      "description": "Independent cross-vendor fact and citation verifier. Re-checks claims and their references via pi_search and file reads; read-only.",
      "steps": 40,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "write", "resource": "*", "effect": "deny" },
        { "action": "patch", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" }
      ]
    },

    // Mid-level escalation: stuck debugging, high blast radius.
    "escalate-opus": {
      "mode": "subagent",
      "model": "openrouter/anthropic/claude-opus-5.5",
      "description": "Escalation for repeated failures or high-blast-radius changes (data, auth, migrations, release). May edit; reports reasoning and risk.",
      "steps": 60,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" }
      ]
    },

    // Top-ceiling escalation.
    "escalate-fable": {
      "mode": "subagent",
      "model": "openrouter/anthropic/claude-fable-5.2",
      "description": "Top-ceiling escalation for genuinely frontier-hard problems after lower tiers fail. May edit; reports reasoning and remaining risk.",
      "steps": 60,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" }
      ]
    },

    // Cross-vendor reviewer used when Claude wrote the code. GPT-6.1 Terra is banned.
    "alt-reviewer": {
      "mode": "subagent",
      "model": "openrouter/openai/gpt-6.2-sol",
      "description": "Non-Anthropic reviewer/fact-checker used whenever Claude produced the code or claims. Read-only.",
      "steps": 40,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "write", "resource": "*", "effect": "deny" },
        { "action": "patch", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" }
      ]
    }
  },

  "mcp": {
    "servers": {
      "pi_search": {
        "type": "local",
        "command": ["/root/pi-projects/pi-search/bin/pi-search", "mcp"],
        "cwd": "/root/pi-projects/pi-search",
        "environment": {
          "PI_SEARCH_SEARXNG_URL": "http://127.0.0.1:8080",
          "PI_SEARCH_DECISION_MODEL": "~perplexity/pplx-decider-latest"
        },
        "codemode": true
      }
    }
  },

  // Local audit plugin (implemented in Wave 2B; loaded and verified in Wave 3A).
  "plugins": ["/root/pi-projects/opencode-workflow/plugins/audit-logger"]
}
